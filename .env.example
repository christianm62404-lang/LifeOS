# =============================================================================
# LifeOS Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in the values. LifeOS runs fully on
# the free Supabase tier and Stripe test mode — no paid APIs required.
# =============================================================================

# ---- Supabase (required) ----------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Private bucket used for document uploads (create it in Storage). Default: documents
NEXT_PUBLIC_SUPABASE_DOCUMENTS_BUCKET=documents

# Public base URL of the app — used for auth + Stripe redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Billing toggle ---------------------------------------------------------
# When false (default) every signed-in user is treated as Pro, so the whole app
# is usable locally WITHOUT configuring Stripe. Set to true to enforce paid
# plans (requires the Stripe + service-role values below).
BILLING_ENABLED=false

# ---- Supabase service role (server-only; required only if BILLING_ENABLED) ---
# Project Settings -> API -> service_role secret. NEVER expose this to the
# browser or commit it. Used solely by the Stripe webhook to update tiers.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (server-only; required only if BILLING_ENABLED) -----------------
# Use TEST mode keys (sk_test_...) — free to develop with, no real charges.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the Dashboard webhook signing secret.
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs (Stripe Dashboard -> Products). $7.99 and $14.99 / month.
STRIPE_PERSONAL_PRICE_ID=
STRIPE_PRO_PRICE_ID=
