# =============================================================================
# LifeOS Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings -> API). LifeOS runs fully on the free Supabase
# tier — no paid APIs required.
# =============================================================================

# Your Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anon/public key (safe to expose in the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The name of the Supabase Storage bucket used for document uploads.
# Defaults to "documents". Create this bucket in the Supabase dashboard
# (Storage -> New bucket) and keep it private.
NEXT_PUBLIC_SUPABASE_DOCUMENTS_BUCKET=documents

# Public base URL of the app — used for auth email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
