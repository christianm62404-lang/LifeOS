# =========================================================================
# Receipt Vault — Environment Variables
# Copy this file to `.env.local` and fill in the values.
# =========================================================================

# --- Supabase (required) -------------------------------------------------
# Find these in your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://olpzozndahonihegzrtk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9scHpvem5kYWhvbmloZWd6cnRrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODE4MzIxNTcsImV4cCI6MjA5NzQwODE1N30.KuuBnqkE1FHMvaK2D2fzI3rga4Z2qo3PcojeunKztfE

# Service role key — server-only. NEVER expose to the client.
# Used for privileged storage/admin operations if needed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Name of the Supabase Storage bucket that holds receipt files.
# Create it in the Supabase dashboard (Storage) — see README.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=receipts

# --- AI extraction (optional) -------------------------------------------
# If OPENAI_API_KEY is not set, the app falls back to a deterministic MOCK
# extractor so it runs fully without any paid API.
OPENAI_API_KEY=
# Override the base URL to use any OpenAI-compatible endpoint (e.g. local LLM).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
